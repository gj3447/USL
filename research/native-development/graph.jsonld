    {
      "@id": "urn:usl:usl.native.development:resource:urn%3Ausl%3Adev%3Areq%3AR02",
      "@type": [
        "usl:Resource",
        "urn:usl:native-development:Requirement"
      ],
      "usl:nativeId": "urn:usl:dev:req:R02",
      "usl:locator": "file://usl-root/research/native-development/plan.json",
      "usl:metadata": {
        "@value": {
          "id": "R02",
          "title": "하나의 프로필 전환",
          "statement": "owner 범위의 불변 프로필과 단조 증가 generation을 사용한다. 한 포인터 전환에 CAS, rollback 새 generation, 이전 admission 무효화를 묶는다.",
          "authorityClass": "SECONDARY_AI",
          "derivedFrom": [
            "wig:native:source:user",
            "omc:source:mobility-request",
            "urn:usl:dev:source:build"
          ],
          "selector": {
