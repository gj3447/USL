      "usl:locator": "file://usl-root/research/native-development/plan.json",
      "usl:metadata": {
        "@value": {
          "id": "R03",
          "title": "Git·파일 native 관측",
          "statement": "worktree/common-dir/HEAD/object-format/ref/dirty/파일 digest를 Git native query로 관측하고 지원 capability를 기록한다.",
          "authorityClass": "SECONDARY_AI",
          "derivedFrom": [
            "wig:native:source:user",
            "omc:source:mobility-request",
            "urn:usl:dev:source:build"
