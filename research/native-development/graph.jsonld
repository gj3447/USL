    {
      "@id": "urn:usl:usl.native.development:resource:urn%3Ausl%3Adev%3Areq%3AR04",
      "@type": [
        "usl:Resource",
        "urn:usl:native-development:Requirement"
      ],
      "usl:nativeId": "urn:usl:dev:req:R04",
      "usl:locator": "file://usl-root/research/native-development/plan.json",
      "usl:metadata": {
        "@value": {
          "id": "R04",
          "title": "선택한 dirty 상태 이동",
          "statement": "clean Git bundle과 독립 pin을 가진 raw-state sidecar를 연결해 선택한 상태를 복원한다. 미지원 상태는 HOLD한다.",
          "authorityClass": "SECONDARY_AI",
          "derivedFrom": [
            "wig:native:source:user",
            "omc:source:mobility-request",
            "urn:usl:dev:source:build"
