      "usl:metadata": {
        "@value": {
          "id": "R01",
          "title": "위치 독립 리소스 ID",
          "statement": "컴퓨터·경로·worktree가 바뀌어도 논리 ID, 역할, 출처를 유지하고 representation만 명시 선택한다.",
          "authorityClass": "SECONDARY_AI",
