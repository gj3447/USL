    {
      "@id": "urn:usl:dev:work:P01",
      "@type": [
        "urn:usl:native-development:WorkItem"
      ],
      "nd:id": "P01",
      "nd:title": "프로필·admission 계약과 fixture",
      "nd:status": "PLANNED",
      "nd:authorityClass": "SECONDARY_AI",
      "nd:ownerBoundary": "USL addon의 순수 계약; host가 소유·저장·실행을 담당",
