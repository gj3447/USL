      "@type": [
        "urn:usl:native-development:Requirement"
      ],
      "nd:id": "R01",
      "nd:title": "위치 독립 리소스 ID",
      "nd:statement": "컴퓨터·경로·worktree가 바뀌어도 논리 ID, 역할, 출처를 유지하고 representation만 명시 선택한다.",
      "nd:authorityClass": "SECONDARY_AI",
      "nd:selectorStatus": "OWNER_READ_REQUIRED",
      "nd:viewScope": "LOCAL_DEVELOPMENT_PLAN",
