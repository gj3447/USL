@prefix ni: <urn:usl:native-implementation:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# These shapes validate only the implementation-progress projection.
ni:WorkShape a sh:NodeShape ; sh:targetClass ni:ImplementationWork ;
  sh:nodeKind sh:IRI ;
  sh:property [ sh:path ni:status ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:in ("PLANNED" "PARTIAL" "CODE_PRESENT_NOT_VERIFIED" "IMPLEMENTED_BOUNDED") ] ;
  sh:property [ sh:path ni:snapshotOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class ni:HistoricalReference ] ;
  sh:property [ sh:path ni:derivedFrom ; sh:maxCount 1 ; sh:class ni:HistoricalPlanSnapshot ] ;
  sh:property [ sh:path ni:addresses ; sh:minCount 1 ; sh:class ni:HistoricalReference ] ;
  sh:property [ sh:path ni:implementedBy ; sh:maxCount 1 ; sh:class ni:Artifact ; sh:node [ sh:property [ sh:path ni:role ; sh:hasValue "CODE" ] ] ] ;
  sh:property [ sh:path ni:checkedBy ; sh:maxCount 1 ; sh:class ni:Artifact ; sh:node [ sh:property [ sh:path ni:role ; sh:hasValue "TEST" ] ] ] ;
  sh:property [ sh:path ni:observedBy ; sh:maxCount 1 ; sh:class ni:ObservedCheck ] ;
  sh:or (
    [ sh:property [ sh:path ni:status ; sh:in ("PLANNED" "PARTIAL") ] ;
      sh:property [ sh:path ni:implementedBy ; sh:maxCount 0 ] ;
      sh:property [ sh:path ni:checkedBy ; sh:maxCount 0 ] ;
      sh:property [ sh:path ni:observedBy ; sh:maxCount 0 ] ]
    [ sh:property [ sh:path ni:status ; sh:hasValue "CODE_PRESENT_NOT_VERIFIED" ] ;
      sh:property [ sh:path ni:implementedBy ; sh:minCount 1 ] ;
      sh:property [ sh:path ni:checkedBy ; sh:minCount 1 ] ;
      sh:property [ sh:path ni:observedBy ; sh:maxCount 0 ] ]
    [ sh:property [ sh:path ni:status ; sh:hasValue "IMPLEMENTED_BOUNDED" ] ;
      sh:property [ sh:path ni:implementedBy ; sh:minCount 1 ] ;
      sh:property [ sh:path ni:checkedBy ; sh:minCount 1 ] ;
      sh:property [ sh:path ni:observedBy ; sh:minCount 1 ] ]
  ) .
ni:ArtifactShape a sh:NodeShape ; sh:targetClass ni:Artifact ;
  sh:property [ sh:path ni:role ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("CODE" "TEST") ] ;
  sh:property [ sh:path ni:sha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^sha256:[a-f0-9]{64}$" ] .
ni:CheckShape a sh:NodeShape ; sh:targetClass ni:ObservedCheck ;
  sh:property [ sh:path ni:status ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "PASS" ] .
ni:HistoryShape a sh:NodeShape ; sh:targetClass ni:HistoricalReference, ni:HistoricalPlanSnapshot ;
  sh:property [ sh:path ni:sha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^sha256:[a-f0-9]{64}$" ] .
