      "usl:metadata": {
        "@value": {
          "id": "technology:S08",
          "title": "Airbyte Agents, 기존 커넥터 모델",
          "sources": [
            "https://docs.airbyte.com/ai-agents/",
            "https://github.com/airbytehq/airbyte/blob/master/docs/platform/move-data/sources-destinations-connectors.md"
          ],
          "upstreamCapability": "데이터 복제뿐 아니라 에이전트의 API 연결·검색·행동을 위한 별도 기능군",
          "classification": "SCOPE_BOUNDARY",
          "limitation": "복제·agent 연결에서 원본 상태와 수집/검색된 표현의 버전 차이를 추적해야 한다.",
          "requirement": "source snapshot과 mapping completeness를 실행 계약에 고정한다.",
          "attack": "이전 수집 버전의 descriptor로 새로운 원본에 대한 호출을 요청한다.",
          "expected": "stale pin과 부분 매핑을 거부한다.",
          "controls": [
            "C05",
