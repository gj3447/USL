        "@value": {
          "id": "technology:S01",
          "title": "OSLC Core 3.0",
          "sources": [
            "https://docs.oasis-open-projects.org/oslc-op/core/v3.0/os/oslc-core.html"
          ],
          "upstreamCapability": "공학 도구 자원의 연합 연결, capability 발견, resource shape",
          "classification": "SCOPE_BOUNDARY",
          "limitation": "도구 간 연결·shape만으로 코드가 요구사항을 만족함이 확정되지 않는다.",
          "requirement": "요구사항/구현/실행 근거의 역할을 검사하고 검증 범위를 유지한다.",
          "attack": "시험 결과 타입의 자원을 코드 역할에 연결하고 OSLC 연결이 있으므로 구현 검증 완료라고 해석한다.",
          "expected": "타입 불일치를 거부하고 의미의 참은 미평가로 유지한다.",
          "controls": [
            "C01",
            "C10"
          ],
          "residual": "OSLC endpoint discovery와 lifecycle domain API driver는 아직 구현하지 않았다.",
          "nativeId": "S01",
          "controlIds": [
            "control:C01",
            "control:C10"
          ],
