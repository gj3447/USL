      ],
      "s:title": "RDF 1.1 Concepts",
      "s:publicationStatus": "W3C_RECOMMENDATION_2014-02-25",
      "s:checkedOn": "2026-10-03",
      "s:fact": "RDF graph는 IRI·blank node·literal을 사용하는 triple 집합이며 dataset은 default graph와 named graph를 갖는다.",
      "s:limit": "선택한 명세 범위의 설명이며 USL 구현 적합성을 인증하지 않는다.",
      "s:access": "PUBLIC_SPEC_SECTIONS",
      "s:url": {
        "@id": "https://www.w3.org/TR/rdf11-concepts/"
      }
    },
