        "@value": {
          "id": "reference:git-submodule",
          "title": "Git submodule",
          "url": "https://git-scm.com/docs/git-submodule",
          "publicationStatus": "OFFICIAL_DOCUMENTATION",
          "sections": "Description; update",
          "checkedOn": "2026-10-03",
          "fact": "Submodule은 superproject에 연결되는 별도 Git 저장소다.",
          "limit": "상위 저장소의 bundle은 하위 저장소 object와 작업 상태의 보존 증명이 아니다.",
          "factKind": "AI_PARAPHRASE_OF_PRIMARY_SOURCE",
