      ],
      "usl:nativeId": "reference:git-lfs",
      "usl:locator": "https://git-lfs.com/",
      "usl:metadata": {
        "@value": {
          "id": "reference:git-lfs",
          "title": "Git Large File Storage",
          "url": "https://git-lfs.com/",
          "publicationStatus": "OFFICIAL_PROJECT_DOCUMENTATION",
          "sections": "Overview",
          "checkedOn": "2026-10-03",
          "fact": "Git LFS는 Git에 pointer를 두고 큰 파일 내용은 별도 서버에 보관한다.",
          "limit": "Pointer가 있다는 사실은 복원할 payload bytes가 번들 안에 있다는 뜻이 아니다.",
          "factKind": "AI_PARAPHRASE_OF_PRIMARY_SOURCE",
          "sourceBodyDigest": "NOT_RECORDED"
        },
        "@type": "@json"
      }
    },
    {
      "@id": "urn:usl:usl.portability.research:resource:reference%3Arename",
