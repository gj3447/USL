        "@value": {
          "id": "reference:rename",
          "title": "Linux rename",
          "url": "https://man7.org/linux/man-pages/man2/rename.2.html",
          "publicationStatus": "LINUX_INTERFACE_DOCUMENTATION",
          "sections": "Description; EXDEV; RENAME_NOREPLACE",
          "checkedOn": "2026-10-03",
          "fact": "지원되는 rename은 이름 변경을 원자적으로 수행하지만 다른 mount 사이에서는 EXDEV가 발생한다.",
          "limit": "기존 목적지 덮어쓰기 금지와 crash durability는 단순 rename 호출만으로 얻지 못한다.",
          "factKind": "AI_PARAPHRASE_OF_PRIMARY_SOURCE",
          "sourceBodyDigest": "NOT_RECORDED"
        },
