    {
      "@id": "urn:usl:usl.syntax.cli.architecture:resource:task%3AC01",
      "@type": [
        "usl:Resource",
        "urn:usl:syntax-cli:Task"
      ],
      "usl:nativeId": "task:C01",
      "usl:locator": "https://github.com/gj3447/USL/blob/master/research/architecture/core-cli.plan.json",
      "usl:metadata": {
        "@value": {
          "id": "task:C01",
          "order": 1,
          "title": "Main entry help and command-family contracts",
          "dependsOn": [],
          "currentGap": "src/cli.ts concatenates every command family into one top-level usage string; delegated command modules expose independent help strings.",
          "deliverables": [
            "src/cli.ts",
            "src/cli-platform.ts",
            "src/cli-adapter.ts",
            "src/cli-host-command.ts",
            "docs/CLI.md",
            "test/cli.test.ts"
          ],
          "acceptance": [
            "Add usl help core|platform|adapter|host without renaming existing commands.",
            "Generate top-level and command-family help from one command contract.",
            "Verify command-family JSON stdout, error stderr, and exits 0/1/2/64 without adding a generic output envelope."
          ],
          "compatibility": [
            "Preserve current command names and command-specific JSON schemas."
          ],
          "status": "PLANNED",
          "implementation": "NOT_STARTED",
          "proofStatus": "NOT_PROVEN",
          "authority": "SECONDARY_AI",
          "sourceStatus": "PLANNED_CORE_CLI_WORK"
        },
        "@type": "@json"
      }
    },
