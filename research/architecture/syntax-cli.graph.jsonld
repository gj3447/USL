          "id": "task:C04",
          "order": 4,
          "title": "Built package-bin compatibility gate",
          "dependsOn": [
            "task:C01"
          ],
          "currentGap": "package.json maps the usl bin to dist/src/cli.js, but current CLI tests invoke TypeScript through tsx rather than a built package bin.",
          "deliverables": [
            "package.json",
            "test/cli-package-bin.test.ts",
            "docs/GETTING_STARTED.md"
          ],
          "acceptance": [
            "After npm run build, invoke the package bin symlink for --help and one pure check fixture.",
            "Verify dist import, shebang and exit status.",
            "Retain moved-workspace and cli-list to cli-inspect tests as compatibility gates rather than new host development.",
            "Provide the built-bin check as an explicit post-build command, preserving the current pre-build npm test workflow."
          ],
          "compatibility": [
            "Do not add tokenizer dependencies or API cost estimates.",
            "Do not change host registration or external execution authority."
          ],
          "status": "PLANNED",
          "implementation": "NOT_STARTED",
          "proofStatus": "NOT_PROVEN",
          "authority": "SECONDARY_AI",
          "sourceStatus": "PLANNED_CORE_CLI_WORK"
