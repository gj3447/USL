        "@value": {
          "id": "task:C03",
          "order": 3,
          "title": "Bounded pure-core stdin/file pipeline",
          "dependsOn": [
            "task:C01"
          ],
          "currentGap": "src/cli.ts reads every source from a file path; there is no bounded UTF-8 --source - contract for pure core pipeline commands.",
          "deliverables": [
            "src/cli.ts",
            "src/cli-io.ts",
            "docs/CLI.md",
            "test/cli.test.ts",
            "test/cli-project-inputs.test.ts"
          ],
          "acceptance": [
            "Support --source - only for check, compile and context.",
            "Bound bytes before parsing and give stdin a stable source label in errors/provenance.",
            "Keep observe, file-changing operations and registered-host execution file/config based."
          ],
          "compatibility": [
            "Preserve JSON stdout and --out collision protection.",
            "Do not change registered child-process stdin behavior."
          ],
          "status": "PLANNED",
          "implementation": "NOT_STARTED",
          "proofStatus": "NOT_PROVEN",
          "authority": "SECONDARY_AI",
          "sourceStatus": "PLANNED_CORE_CLI_WORK"
