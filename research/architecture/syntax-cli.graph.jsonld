        "@value": {
          "title": "Existing compact FULL context projection",
          "scope": "scoped AgentContext transport projection with reconstructible paths and target witness",
          "baseline": "context-minified",
          "lanes": "context-minified -> compact-full",
          "implementationStatus": "IMPLEMENTED_CURRENT_USL_FEATURE",
