      "usl:locator": "https://github.com/gj3447/USL/blob/master/research/architecture/core-cli.plan.json",
      "usl:metadata": {
        "@value": {
          "id": "task:C02",
          "order": 2,
          "title": "Adapted context traversal and compact-delivery parity",
          "dependsOn": [
            "task:C01"
          ],
          "currentGap": "src/cli-adapter.ts accepts focus, target and compact for context, but not max-hops/max-links/max-visits/via/max-bytes/known-context/stats despite those being supported by src/cli.ts context.",
          "deliverables": [
            "src/cli-adapter.ts",
            "src/adapters.ts",
            "docs/CLI.md",
            "test/adapter-boundaries.test.ts",
            "test/cli.test.ts"
          ],
          "acceptance": [
            "Support max-hops, max-resources, max-links, max-visits, repeated via, max-bytes, known-context and stats for adapt --operation context.",
            "Use the same validation and compact fallback/error contract as source context.",
            "Preserve native IDs and explicitly selected resource-graph profiles.",
            "Preserve the existing max-resources policy cap when adding the missing query and delivery options."
          ],
          "compatibility": [
            "Keep multiple representations explicit.",
            "Do not equate a resource link with access permission.",
            "Do not add automatic tokenizer dependencies."
          ],
          "status": "PLANNED",
          "implementation": "NOT_STARTED",
          "proofStatus": "NOT_PROVEN",
          "authority": "SECONDARY_AI",
          "sourceStatus": "PLANNED_CORE_CLI_WORK"
        },
        "@type": "@json"
      }
    },
