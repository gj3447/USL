          "title": "gzip/brotli binary transport comparison",
          "scope": "compressed bytes and base64 text counts for each payload lane",
          "baseline": "each text payload lane",
          "lanes": "gzipBytes; brotliBytes; gzipBase64Bytes; brotliBase64Bytes",
          "implementationStatus": "BENCHMARK_TRANSPORT_COMPARISON_NOT_USL_RUNTIME_FEATURE",
          "limitation": "A decoder is required; base64 token counts do not establish lower prompt tokens or model comprehension.",
          "status": "LOCAL_OFFLINE_MEASUREMENT"
        },
        "@type": "@json"
      }
    },
