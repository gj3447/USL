  sh:property [ sh:path (usl:meaning usl:nativeId) ; sh:hasValue "urn:usl:syntax-cli:trace" ] ;
  sh:property [ sh:path (usl:participant usl:role) ; sh:in ( "statement" "feature" "artifact" ) ] ;
  sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "statement" ] ; sh:property [ sh:path usl:resource ; sh:class arc:UserStatement ] ] ] ;
  sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "feature" ] ; sh:property [ sh:path usl:resource ; sh:class arc:ImplementedFeature ] ] ] ;
  sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "artifact" ] ; sh:property [ sh:path usl:resource ; sh:class arc:Artifact ] ] ] .
