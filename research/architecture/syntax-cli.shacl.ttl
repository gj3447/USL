@prefix usl: <urn:usl:vocab:> .
@prefix arc: <urn:usl:syntax-cli:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

arc:ArchitectureRoleShape a sh:NodeShape ; sh:targetClass usl:Link ; sh:or ( arc:interpreted_asShape arc:implemented_byShape arc:traceShape arc:bounded_byShape arc:addressesShape arc:depends_onShape ) .

arc:interpreted_asShape a sh:NodeShape ;
  sh:property [ sh:path (usl:meaning usl:nativeId) ; sh:hasValue "urn:usl:syntax-cli:interpreted_as" ] ;
  sh:property [ sh:path (usl:participant usl:role) ; sh:in ( "statement" "feature" ) ] ;
  sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "statement" ] ; sh:property [ sh:path usl:resource ; sh:class arc:UserStatement ] ] ] ;
  sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "feature" ] ; sh:property [ sh:path usl:resource ; sh:class arc:ImplementedFeature ] ] ] .
arc:implemented_byShape a sh:NodeShape ;
  sh:property [ sh:path (usl:meaning usl:nativeId) ; sh:hasValue "urn:usl:syntax-cli:implemented_by" ] ;
  sh:property [ sh:path (usl:participant usl:role) ; sh:in ( "feature" "artifact" ) ] ;
  sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "feature" ] ; sh:property [ sh:path usl:resource ; sh:class arc:ImplementedFeature ] ] ] ;
  sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "artifact" ] ; sh:property [ sh:path usl:resource ; sh:class arc:Artifact ] ] ] .
arc:traceShape a sh:NodeShape ;
  sh:property [ sh:path (usl:meaning usl:nativeId) ; sh:hasValue "urn:usl:syntax-cli:trace" ] ;
  sh:property [ sh:path (usl:participant usl:role) ; sh:in ( "statement" "feature" "artifact" ) ] ;
  sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "statement" ] ; sh:property [ sh:path usl:resource ; sh:class arc:UserStatement ] ] ] ;
  sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "feature" ] ; sh:property [ sh:path usl:resource ; sh:class arc:ImplementedFeature ] ] ] ;
  sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "artifact" ] ; sh:property [ sh:path usl:resource ; sh:class arc:Artifact ] ] ] .
arc:bounded_byShape a sh:NodeShape ;
  sh:property [ sh:path (usl:meaning usl:nativeId) ; sh:hasValue "urn:usl:syntax-cli:bounded_by" ] ;
  sh:property [ sh:path (usl:participant usl:role) ; sh:in ( "feature" "limitation" ) ] ;
  sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "feature" ] ; sh:property [ sh:path usl:resource ; sh:class arc:ImplementedFeature ] ] ] ;
  sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "limitation" ] ; sh:property [ sh:path usl:resource ; sh:class arc:Limitation ] ] ] .
arc:addressesShape a sh:NodeShape ;
  sh:property [ sh:path (usl:meaning usl:nativeId) ; sh:hasValue "urn:usl:syntax-cli:addresses" ] ;
  sh:property [ sh:path (usl:participant usl:role) ; sh:in ( "proposal" "requirement" ) ] ;
  sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "proposal" ] ; sh:property [ sh:path usl:resource ; sh:class arc:Proposal ] ] ] ;
  sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "requirement" ] ; sh:property [ sh:path usl:resource ; sh:class arc:UserStatement ] ] ] .
arc:depends_onShape a sh:NodeShape ;
  sh:property [ sh:path (usl:meaning usl:nativeId) ; sh:hasValue "urn:usl:syntax-cli:depends_on" ] ;
  sh:property [ sh:path (usl:participant usl:role) ; sh:in ( "proposal" "prerequisite" ) ] ;
  sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "proposal" ] ; sh:property [ sh:path usl:resource ; sh:class arc:Proposal ] ] ] ;
  sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "prerequisite" ] ; sh:property [ sh:path usl:resource ; sh:class arc:Proposal ] ] ] .
