  "proposals": [
    [
      "proposal:weighted-assertion",
      "Versioned semantic weight assertions",
      "Optional addon owns semantic weight interpretation and updates. USL only binds its references/data and preserves roles; weights grant no authority."
    ],
    [
      "proposal:m-map",
      "External M-map index binding",
      "M-map indexing is owned by the addon or consuming program. USL connects the index, graph and resource references without building or storing the index itself."
    ],
    [
      "proposal:hierarchy",
      "Optional typed hierarchy rules",
      "An addon or owner program defines hierarchy meaning, cycle policy and traversal. USL expresses the selected named relationships and profile references."
    ],
    [
      "proposal:graph-cli",
      "Minimal binding CLI and examples",
      "Keep the existing declaration/check/context/binding CLI simple; demonstrate optional profile selection without adding a domain engine or addon platform."
    ]
