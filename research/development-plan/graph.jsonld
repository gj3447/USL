    {
      "@id": "urn:usl:usl.development.plan:resource:user%3Adevelopment%3Aportability",
      "@type": [
        "usl:Resource",
        "urn:usl:development-plan:UserStatement",
        "http://www.w3.org/ns/prov#Entity"
