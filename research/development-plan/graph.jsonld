    {
      "@id": "urn:usl:usl.development.plan:meaning:urn%3Ausl%3Adevelopment-plan%3Adepends_on",
      "@type": "usl:Meaning",
      "usl:nativeId": "urn:usl:development-plan:depends_on",
      "usl:description": "Future task requires prerequisite in this planning snapshot; these edges alone form a DAG"
    },
    {
      "@id": "urn:usl:usl.development.plan:meaning:urn%3Ausl%3Adevelopment-plan%3Arequires_reconciliation",
      "@type": "usl:Meaning",
      "usl:nativeId": "urn:usl:development-plan:requires_reconciliation",
      "usl:description": "Conditional prerequisite only when this task consumes restored outcomes or receipts; combined dependency graph must also be acyclic"
    },
    {
      "@id": "urn:usl:usl.development.plan:meaning:urn%3Ausl%3Adevelopment-plan%3Aaddresses",
      "@type": "usl:Meaning",
      "usl:nativeId": "urn:usl:development-plan:addresses",
      "usl:description": "Proposed task addresses the derived requirement; not proof of satisfaction"
    },
    {
      "@id": "urn:usl:usl.development.plan:meaning:urn%3Ausl%3Adevelopment-plan%3Abuilds_on",
      "@type": "usl:Meaning",
      "usl:nativeId": "urn:usl:development-plan:builds_on",
      "usl:description": "Task reuses an existing implementation within its recorded limits"
    },
    {
      "@id": "urn:usl:usl.development.plan:meaning:urn%3Ausl%3Adevelopment-plan%3Amotivated_by",
      "@type": "usl:Meaning",
      "usl:nativeId": "urn:usl:development-plan:motivated_by",
      "usl:description": "Historical observation, assessment or backlog motivates future work"
    },
    {
      "@id": "urn:usl:usl.development.plan:meaning:urn%3Ausl%3Adevelopment-plan%3Auses_source",
      "@type": "usl:Meaning",
      "usl:nativeId": "urn:usl:development-plan:uses_source",
      "usl:description": "Task derives from this pinned source snapshot"
    },
    {
      "@id": "urn:usl:usl.development.plan:meaning:urn%3Ausl%3Adevelopment-plan%3Avalidated_by",
      "@type": "usl:Meaning",
      "usl:nativeId": "urn:usl:development-plan:validated_by",
      "usl:description": "Future acceptance requirement with NOT_RUN execution"
    },
    {
      "@id": "urn:usl:usl.development.plan:meaning:urn%3Ausl%3Adevelopment-plan%3Afor_task",
      "@type": "usl:Meaning",
      "usl:nativeId": "urn:usl:development-plan:for_task",
      "usl:description": "Criterion belongs to exactly one task in this snapshot"
    },
    {
      "@id": "urn:usl:usl.development.plan:meaning:urn%3Ausl%3Adevelopment-plan%3Arecorded_in",
      "@type": "usl:Meaning",
      "usl:nativeId": "urn:usl:development-plan:recorded_in",
      "usl:description": "Evidence points to a pinned historical source; this build does not replay it"
    },
    {
      "@id": "urn:usl:usl.development.plan:meaning:urn%3Ausl%3Adevelopment-plan%3Arequirement_derived_from",
      "@type": "usl:Meaning",
      "usl:nativeId": "urn:usl:development-plan:requirement_derived_from",
      "usl:description": "AI requirement interpretation is grounded in the source"
    },
    {
      "@id": "urn:usl:usl.development.plan:meaning:urn%3Ausl%3Adevelopment-plan%3Abaseline_derived_from",
      "@type": "usl:Meaning",
      "usl:nativeId": "urn:usl:development-plan:baseline_derived_from",
      "usl:description": "Bounded implementation state is grounded in the source"
    },
    {
      "@id": "urn:usl:usl.development.plan:meaning:urn%3Ausl%3Adevelopment-plan%3Ainterprets",
      "@type": "usl:Meaning",
      "usl:nativeId": "urn:usl:development-plan:interprets",
      "usl:description": "AI interpretation of primary user words; never user canon by inference"
    },
