    {
      "@id": "artifact:tsconfig.json",
      "@type": "w:SourceFile",
      "w:path": "tsconfig.json",
      "w:sha256": "sha256:30ca9a93e51148cb6791dfe5b757267a0b4455d08ce525c20fe24366c9c023c3"
    },
    {
      "@id": "source:git-worktree",
      "@type": "w:PrimarySource",
      "w:url": {
        "@id": "https://git-scm.com/docs/git-worktree"
      },
      "w:fact": "linked tree의 HEAD/index는 개별이고 공통 Git 데이터는 공유된다. move와 repair가 관리 경로를 연결한다.",
      "w:limit": "실행 검증은 receipt의 설치 버전에 한정. 최신 Git의 relative-path mode 등 추가 기능을 실행했다고 주장하지 않는다.",
      "w:checkedOn": "2026-10-03"
    },
    {
      "@id": "source:git-layout",
      "@type": "w:PrimarySource",
      "w:url": {
        "@id": "https://git-scm.com/docs/gitrepository-layout"
      },
      "w:fact": "gitfile 및 common directory와 worktree별 관리 파일을 구분한다. object store는 alternates에 의존할 수도 있다.",
      "w:limit": "이번 시험은 submodule/LFS/alternates 전체 복원 적합성 검사가 아니다.",
      "w:checkedOn": "2026-10-03"
    },
    {
      "@id": "check:checkout-guard",
      "@type": "w:FutureCheck",
      "w:execution": "NOT_RUN",
      "w:expectation": "명시한 owner worktree/revision/dirty 정책과 관측을 대조해 wrong alias를 거부한다."
    },
    {
      "@id": "check:closed-git-backup",
      "@type": "w:FutureCheck",
      "w:execution": "NOT_RUN",
      "w:expectation": "main/linked 관리 데이터·index·미추적 및 ignored 선택 파일·submodule·LFS·alternates 의존성을 닫은 bundle을 복원하고 원래 저장소 없이 검증한다."
    },
    {
      "@id": "check:atomic-capture",
      "@type": "w:FutureCheck",
      "w:execution": "NOT_RUN",
      "w:expectation": "concurrent checkout/rebase/rename와 파일변경 도중 일관성 있는 capture 또는 명시적 거부를 검증한다."
    },
    {
      "@id": "check:cross-machine-operations",
      "@type": "w:FutureCheck",
      "w:execution": "NOT_RUN",
      "w:expectation": "분리된 머신·저장소·네트워크 단절에서도 owner operation registry와 충돌/효과 대조 계약을 검증한다."
    },
    {
      "@id": "check:platforms",
      "@type": "w:FutureCheck",
      "w:execution": "NOT_RUN",
      "w:expectation": "Windows/macOS 및 다른 filesystem·Git 버전에서 path, case, unicode, symlink, durability, worktree repair를 검증한다."
    }
  ]
}
