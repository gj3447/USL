      "usl:metadata": {
        "@value": {
          "id": "acceptance:CP20-1",
          "expectation": "74개 record ID를 그대로 추적하며 suite case별 PASS/FAIL/SKIP/NOT_RUN과 loss/지원 제외 사유를 공개한다. 새 edition/draft 변경은 원문 재검토 task로 연결한다.",
          "negativeCase": "wrapper SHACL 통과나 전체 수량 일치만으로 domain conformance 또는 standards superset을 주장하면 실패.",
          "execution": "NOT_RUN",
          "packageId": "package:CP20"
        },
        "@type": "@json"
      }
    },
    {
      "@id": "urn:usl:usl.completion.plan:resource:acceptance%3ACP20-2",
      "@type": [
        "usl:Resource",
        "urn:usl:completion-plan:Acceptance",
