      "usl:metadata": {
        "@value": {
          "id": "criterion:DG02-C3",
          "taskId": "task:DG02",
          "expectation": "stable ID·named/n-ary roles·metadata·provenance를 보존하며 raw byte digest·contract digest·RDF dataset digest·entailment 비교를 구분한다. 외부 context는 pinned/bundled 허용 목록과 예산으로 제한한다.",
          "negativeCase": "blank-node label이나 semantic similarity를 자원 ID로 쓰거나 stale dictionary/cache로 다른 그래프를 복원하면 실패.",
          "execution": "NOT_RUN",
          "sourceCommit": "250bfffb0463aa94feea5619691a7fb3ed68630d",
