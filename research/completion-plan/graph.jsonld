      "usl:metadata": {
        "@value": {
          "id": "criterion:DG02-C2",
          "taskId": "task:DG02",
          "expectation": "선택 profile의 IRI·typed/language literal·blank-node scope·default/named graph·빈 graph 표현 한계와 LPG node/edge property·label을 왕복하거나 정확히 명시한 손실/거부 결과를 낸다.",
          "negativeCase": "원문 domain triple 대신 USL 선언 wrapper만 출력하고 무손실 roundtrip이라고 하거나 임의 property를 조용히 버리면 실패.",
          "execution": "NOT_RUN",
          "sourceCommit": "250bfffb0463aa94feea5619691a7fb3ed68630d",
