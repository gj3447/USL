      ],
      "usl:nativeId": "acceptance:CP20-2",
      "usl:locator": "https://github.com/gj3447/USL/blob/master/research/completion-plan/plan.json",
      "usl:metadata": {
        "@value": {
          "id": "acceptance:CP20-2",
          "expectation": "known-wrong fixture와 engine 직접/adapter 결과 차이를 탐지한다. 기능 완료에 필요한 profile은 근거 미확보 시 HOLD이며 제외로 완료 수를 올리지 않는다.",
          "negativeCase": "suite/license/규범 전문 접근이 없는데 PASS 또는 FULL_SUPPORT로 기록하면 실패.",
          "execution": "NOT_RUN",
          "packageId": "package:CP20"
        },
        "@type": "@json"
      }
    },
    {
      "@id": "urn:usl:usl.completion.plan:resource:acceptance%3ACP21-1",
      "@type": [
        "usl:Resource",
        "urn:usl:completion-plan:Acceptance",
