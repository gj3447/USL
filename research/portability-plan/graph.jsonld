      "usl:metadata": {
        "@value": {
          "id": "reference:rdf-canon",
          "title": "RDF Dataset Canonicalization 1.0",
          "url": "https://www.w3.org/TR/rdf-canon/",
          "publicationStatus": "W3C_RECOMMENDATION",
          "checkedOn": "2026-10-03",
          "application": "선택적 RDF dataset 정규화와 그래프 digest.",
          "limit": "RDF 동형성 범위이며 의미 동치나 revision 간 blank-node identity 보장이 아니다."
        },
        "@type": "@json"
      }
    },
