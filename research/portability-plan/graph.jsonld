          "sourceDigest": "sha256:96fc02d8fc8c6d633b82ee0aeb006eec68fa9623b1257f14619724d9b68e05db",
          "scope": "PLAN_ARTIFACT_GENERATION_ONLY"
        },
        "@type": "@json"
      }
    },
    {
      "@id": "urn:usl:usl.portability.plan:resource:user%3Aportability-plan",
      "@type": [
        "usl:Resource",
        "urn:usl:status:Source"
      ],
      "usl:nativeId": "user:portability-plan",
      "usl:locator": "https://github.com/gj3447/USL/blob/master/research/portability-plan/plan.json",
      "usl:metadata": {
        "@value": {
          "id": "user:portability-plan",
          "authority": "USER_PRIMARY",
          "text": "ㅇㅇ 해당 내용 표준그래프 엔지니어링으로 작업 계획좀 세워줘봐봐 ㅇㅇ",
          "motivation": {
            "authority": "USER_PRIMARY",
            "text": "ㅇㅇ 그 다른 컴퓨터 왓다갓다 해도 그 백업 메모리 작업환경 마구 옮기더라도 USL 은 강건해야하거든 어떡하면 그렇게 할수 있을지 인터넷 검색좀해줘봐봐 ㅇㅇ"
          },
          "scope": "REQUEST_FOR_WORK_PLAN"
        },
        "@type": "@json"
      }
    },
    {
      "@id": "urn:usl:usl.portability.plan:resource:activity%3Aportability-planning",
      "@type": [
        "usl:Resource",
        "http://www.w3.org/ns/prov#Activity",
        "urn:usl:status:PlanningActivity"
      ],
      "usl:nativeId": "activity:portability-planning",
      "usl:locator": "https://github.com/gj3447/USL/blob/master/research/portability-plan/plan.json",
      "usl:metadata": {
        "@value": {
          "runtimeImplementation": "NOT_STARTED",
          "scope": "SOURCE_PINS_TASK_DAG_TYPED_GRAPH_ROLES_AND_EXACT_COMPETENCY_RESULTS_ONLY"
        },
        "@type": "@json"
      }
    },
    {
      "@id": "urn:usl:usl.portability.plan:resource:agent%3Aportability-planner",
      "@type": [
        "usl:Resource",
        "http://www.w3.org/ns/prov#Agent",
        "urn:usl:status:Agent"
      ],
      "usl:nativeId": "agent:portability-planner",
      "usl:locator": "https://github.com/gj3447/USL/blob/master/research/portability-plan/plan.json",
      "usl:metadata": {
        "@value": {
          "authority": "SECONDARY_AI",
          "ratification": "NOT_CLAIMED"
        },
        "@type": "@json"
      }
    },
    {
      "@id": "urn:usl:usl.portability.plan:resource:requirement%3AR01",
      "@type": [
        "usl:Resource",
        "urn:usl:status:Requirement"
      ],
      "usl:nativeId": "requirement:R01",
      "usl:locator": "https://github.com/gj3447/USL/blob/master/research/portability-plan/plan.json",
      "usl:metadata": {
        "@value": {
          "id": "requirement:R01",
          "text": "컴퓨터와 경로가 바뀌어도 자원 ID와 선택한 버전 및 역할을 보존한다.",
          "authority": "SECONDARY_AI",
          "derivedFrom": "user:portability-plan"
        },
        "@type": "@json"
      }
    },
    {
      "@id": "urn:usl:usl.portability.plan:resource:requirement%3AR02",
      "@type": [
        "usl:Resource",
        "urn:usl:status:Requirement"
      ],
      "usl:nativeId": "requirement:R02",
      "usl:locator": "https://github.com/gj3447/USL/blob/master/research/portability-plan/plan.json",
      "usl:metadata": {
        "@value": {
          "id": "requirement:R02",
          "text": "선택한 복원 범위의 파일과 의존성 누락·손상·혼합 snapshot을 판별한다.",
          "authority": "SECONDARY_AI",
          "derivedFrom": "user:portability-plan"
        },
        "@type": "@json"
      }
    },
    {
      "@id": "urn:usl:usl.portability.plan:resource:requirement%3AR03",
      "@type": [
        "usl:Resource",
        "urn:usl:status:Requirement"
      ],
      "usl:nativeId": "requirement:R03",
      "usl:locator": "https://github.com/gj3447/USL/blob/master/research/portability-plan/plan.json",
      "usl:metadata": {
        "@value": {
          "id": "requirement:R03",
          "text": "기존 작업환경을 덮어쓰지 않고 검증된 묶음만 새 로컬 바인딩으로 활성화한다.",
          "authority": "SECONDARY_AI",
          "derivedFrom": "user:portability-plan"
        },
        "@type": "@json"
      }
    },
    {
      "@id": "urn:usl:usl.portability.plan:resource:requirement%3AR04",
      "@type": [
        "usl:Resource",
        "urn:usl:status:Requirement"
      ],
      "usl:nativeId": "requirement:R04",
      "usl:locator": "https://github.com/gj3447/USL/blob/master/research/portability-plan/plan.json",
      "usl:metadata": {
        "@value": {
          "id": "requirement:R04",
          "text": "파일과 메모리 조각의 위치 변경, 그래프 직렬화 차이를 자원 정체성과 구분한다.",
          "authority": "SECONDARY_AI",
          "derivedFrom": "user:portability-plan"
        },
        "@type": "@json"
      }
    },
    {
      "@id": "urn:usl:usl.portability.plan:resource:requirement%3AR05",
      "@type": [
        "usl:Resource",
        "urn:usl:status:Requirement"
      ],
      "usl:nativeId": "requirement:R05",
      "usl:locator": "https://github.com/gj3447/USL/blob/master/research/portability-plan/plan.json",
      "usl:metadata": {
        "@value": {
          "id": "requirement:R05",
          "text": "서로 다른 기기의 수정·삭제·옛 백업을 구분하며 충돌과 이력을 보존한다.",
          "authority": "SECONDARY_AI",
          "derivedFrom": "user:portability-plan"
        },
        "@type": "@json"
      }
    },
    {
      "@id": "urn:usl:usl.portability.plan:resource:requirement%3AR06",
      "@type": [
        "usl:Resource",
        "urn:usl:status:Requirement"
      ],
      "usl:nativeId": "requirement:R06",
      "usl:locator": "https://github.com/gj3447/USL/blob/master/research/portability-plan/plan.json",
      "usl:metadata": {
        "@value": {
          "id": "requirement:R06",
          "text": "이동한 링크와 과거 실행 기록을 접근 권한 또는 현재 외부 효과로 승격하지 않는다.",
          "authority": "SECONDARY_AI",
          "derivedFrom": "user:portability-plan"
        },
        "@type": "@json"
      }
    },
    {
      "@id": "urn:usl:usl.portability.plan:resource:requirement%3AR07",
      "@type": [
        "usl:Resource",
        "urn:usl:status:Requirement"
      ],
      "usl:nativeId": "requirement:R07",
      "usl:locator": "https://github.com/gj3447/USL/blob/master/research/portability-plan/plan.json",
      "usl:metadata": {
        "@value": {
          "id": "requirement:R07",
          "text": "다른 OS와 복원 실패 상황에서 불변식과 실패 상태를 실제로 검증한다.",
          "authority": "SECONDARY_AI",
          "derivedFrom": "user:portability-plan"
        },
        "@type": "@json"
      }
    },
    {
      "@id": "urn:usl:usl.portability.plan:resource:reference%3Auuid",
      "@type": [
        "usl:Resource",
        "urn:usl:status:Source",
        "urn:usl:status:ExternalSource"
      ],
      "usl:nativeId": "reference:uuid",
      "usl:locator": "https://www.rfc-editor.org/rfc/rfc9562.html",
      "usl:metadata": {
        "@value": {
          "id": "reference:uuid",
          "title": "UUID RFC 9562",
          "url": "https://www.rfc-editor.org/rfc/rfc9562.html",
          "publicationStatus": "IETF_STANDARDS_TRACK",
          "checkedOn": "2026-10-03",
          "application": "새 자원의 식별자 발급 참고. 기존 owner-native ID는 유지한다.",
          "limit": "UUID는 내용·소유권·최신 상태·인과 순서를 인증하지 않는다."
        },
        "@type": "@json"
      }
    },
    {
      "@id": "urn:usl:usl.portability.plan:resource:reference%3Ahash-name",
      "@type": [
        "usl:Resource",
        "urn:usl:status:Source",
        "urn:usl:status:ExternalSource"
      ],
      "usl:nativeId": "reference:hash-name",
      "usl:locator": "https://www.rfc-editor.org/info/rfc6920/",
      "usl:metadata": {
        "@value": {
          "id": "reference:hash-name",
          "title": "Naming Things with Hashes RFC 6920",
          "url": "https://www.rfc-editor.org/info/rfc6920/",
          "publicationStatus": "IETF_STANDARDS_TRACK",
          "checkedOn": "2026-10-03",
          "application": "버전 원문에 대한 알고리즘 명시 해시 식별 참고.",
          "limit": "내용 일치가 자원 정체성이나 권한 일치를 뜻하지 않는다."
        },
        "@type": "@json"
      }
    },
    {
      "@id": "urn:usl:usl.portability.plan:resource:reference%3Abagit",
      "@type": [
        "usl:Resource",
        "urn:usl:status:Source",
        "urn:usl:status:ExternalSource"
      ],
      "usl:nativeId": "reference:bagit",
      "usl:locator": "https://www.rfc-editor.org/info/rfc8493/",
      "usl:metadata": {
        "@value": {
          "id": "reference:bagit",
          "title": "BagIt RFC 8493",
          "url": "https://www.rfc-editor.org/info/rfc8493/",
          "publicationStatus": "RFC_INFORMATIONAL",
          "checkedOn": "2026-10-03",
          "application": "파일 목록과 checksum으로 complete/valid를 구별하는 전송 모델.",
          "limit": "BagIt 준수를 선언하려면 별도 완전한 형식 검증이 필요하다."
        },
        "@type": "@json"
      }
    },
    {
      "@id": "urn:usl:usl.portability.plan:resource:reference%3Aocfl",
      "@type": [
        "usl:Resource",
        "urn:usl:status:Source",
        "urn:usl:status:ExternalSource"
      ],
      "usl:nativeId": "reference:ocfl",
      "usl:locator": "https://ocfl.io/1.1/spec/",
      "usl:metadata": {
        "@value": {
          "id": "reference:ocfl",
          "title": "Oxford Common File Layout 1.1",
          "url": "https://ocfl.io/1.1/spec/",
          "publicationStatus": "COMMUNITY_SPECIFICATION",
          "checkedOn": "2026-10-03",
          "application": "객체 ID·버전·logical/content path 분리, inventory와 복원 가능성.",
          "limit": "OCFL 저장소를 구현하거나 원격 가용성을 보장한다는 뜻이 아니다."
        },
        "@type": "@json"
      }
    },
    {
      "@id": "urn:usl:usl.portability.plan:resource:reference%3Aannotation",
      "@type": [
        "usl:Resource",
        "urn:usl:status:Source",
        "urn:usl:status:ExternalSource"
      ],
      "usl:nativeId": "reference:annotation",
      "usl:locator": "https://www.w3.org/TR/annotation-model/",
      "usl:metadata": {
        "@value": {
          "id": "reference:annotation",
          "title": "Web Annotation Data Model",
          "url": "https://www.w3.org/TR/annotation-model/",
          "publicationStatus": "W3C_RECOMMENDATION",
          "checkedOn": "2026-10-03",
          "application": "fragment selector, 인용문과 앞뒤 문맥 및 source state 참고.",
          "limit": "동일 문구가 여러 곳에 있으면 하나를 자동 확정하지 않는다."
        },
        "@type": "@json"
      }
    },
    {
      "@id": "urn:usl:usl.portability.plan:resource:reference%3Ardf-canon",
