meaning geip_edge_meaning_5f1a0392bab2bcb9_8b5cc4df7eec7d32(source: any, target: any, graphspec: filesystem) = "GraphSpec 구조 간선 선언: {\"edge\":{\"data_contract_ref\":\"schema://seed/v1\",\"id\":\"e1\",\"kind\":\"data\",\"semantic_relation\":\"need-measurement\",\"source\":\"Seed\",\"target\":\"Router\"},\"graph_id\":\"symposium.graph-engineering.smoke\",\"graph_version\":\"0.1.0-draft\",\"graphspec_sha256\":\"69e9c0ed665fa00754a5e02a55e44d3f4165dbb625ccdce5ae7bbe60049d0af6\"}. 실행, 인과성, 효과 성공을 증명하지 않는다." applies "GEIP GraphSpec symposium.graph-engineering.smoke@0.1.0-draft 69e9c0ed665fa00754a5e02a55e44d3f4165dbb625ccdce5ae7bbe60049d0af6; {\"edge\":{\"data_contract_ref\":\"schema://seed/v1\",\"id\":\"e1\",\"kind\":\"data\",\"semantic_relation\":\"need-measurement\",\"source\":\"Seed\",\"target\":\"Router\"},\"graph_id\":\"symposium.graph-engineering.smoke\",\"graph_version\":\"0.1.0-draft\",\"graphspec_sha256\":\"69e9c0ed665fa00754a5e02a55e44d3f4165dbb625ccdce5ae7bbe60049d0af6\"}" check graphspec_declaration(graphspec) = "명시적으로 바인딩된 GraphSpec 원문이 이 간선 선언의 근거다.";
