{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "usl-engineering-review/v1"
    },
    "reviewedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "authority": {
      "type": "string",
      "const": "SECONDARY_AI"
    },
    "upstreamExecution": {
      "type": "string",
      "const": "NOT_TESTED"
    },
    "controls": {
      "minItems": 1,
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C\\d{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "implementation": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?:(?:src|test|scripts|schemas)\\/[A-Za-z0-9._/-]+|package(?:-lock)?\\.json|tsconfig\\.json)$"
            }
          },
          "checks": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            }
          },
          "residual": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "title",
          "scope",
          "implementation",
          "checks",
          "residual"
        ],
        "additionalProperties": false
      }
    },
    "technologies": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S\\d{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "sources": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "upstreamCapability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "classification": {
            "type": "string",
            "enum": [
              "SCOPE_BOUNDARY",
              "INTEGRATION_HAZARD"
            ]
          },
          "limitation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "requirement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "attack": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "controls": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^C\\d{2}$"
            }
          },
          "residual": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "title",
          "sources",
          "upstreamCapability",
          "classification",
          "limitation",
          "requirement",
          "attack",
          "expected",
          "controls",
          "residual"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "reviewedAt",
    "authority",
    "upstreamExecution",
    "controls",
    "technologies"
  ],
  "additionalProperties": false
}
