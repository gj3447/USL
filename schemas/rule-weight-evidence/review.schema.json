{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "usl-rule-weight-review/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "allOf": [
        {
          "pattern": "\\S"
        },
        {
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|^`\\\\\\u0000-\\u001f\\u007f]+$"
        },
        {
          "pattern": "^(?:[^%]|%[A-Fa-f0-9]{2})+$"
        }
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "recipe": {
      "type": "object",
      "properties": {
        "policy": {},
        "observations": {},
        "evidence": {},
        "proposalInput": {}
      },
      "required": [
        "policy",
        "observations",
        "evidence",
        "proposalInput"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "dataset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "report": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "baselineSource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "candidateSource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        }
      },
      "required": [
        "dataset",
        "report",
        "baselineSource",
        "candidateSource"
      ],
      "additionalProperties": false
    },
    "mapping": {
      "type": "object",
      "properties": {
        "contextUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "contextRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "baselineActionUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "candidateActionUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "baselineRuleUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "candidateRuleUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "role": {
          "type": "string",
          "const": "policy_snapshot"
        },
        "ordinal": {
          "type": "number",
          "const": 0
        }
      },
      "required": [
        "contextUid",
        "contextRevision",
        "baselineActionUid",
        "candidateActionUid",
        "baselineRuleUid",
        "candidateRuleUid",
        "role",
        "ordinal"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "reviewedAt",
    "recipe",
    "artifacts",
    "mapping"
  ],
  "additionalProperties": false
}
