{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "usl-rule-weight-evidence/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "allOf": [
        {
          "pattern": "\\S"
        },
        {
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|^`\\\\\\u0000-\\u001f\\u007f]+$"
        },
        {
          "pattern": "^(?:[^%]|%[A-Fa-f0-9]{2})+$"
        }
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "context": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|^`\\\\\\u0000-\\u001f\\u007f]+$"
            },
            {
              "pattern": "^(?:[^%]|%[A-Fa-f0-9]{2})+$"
            }
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|^`\\\\\\u0000-\\u001f\\u007f]+$"
            },
            {
              "pattern": "^(?:[^%]|%[A-Fa-f0-9]{2})+$"
            }
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "participants": {
          "minItems": 1,
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "ordinal": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "source": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "allOf": [
                      {
                        "pattern": "\\S"
                      },
                      {
                        "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|^`\\\\\\u0000-\\u001f\\u007f]+$"
                      },
                      {
                        "pattern": "^(?:[^%]|%[A-Fa-f0-9]{2})+$"
                      }
                    ]
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "\\S"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "id",
                  "version",
                  "digest"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "role",
              "ordinal",
              "source"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "version",
        "digest",
        "participants"
      ],
      "additionalProperties": false
    },
    "independentUnit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "selectionProbability": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "evaluationDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "outcome": {
      "type": "object",
      "properties": {
        "metric": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "allOf": [
                {
                  "pattern": "\\S"
                },
                {
                  "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|^`\\\\\\u0000-\\u001f\\u007f]+$"
                },
                {
                  "pattern": "^(?:[^%]|%[A-Fa-f0-9]{2})+$"
                }
              ]
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "direction": {
              "type": "string",
              "enum": [
                "MAXIMIZE",
                "MINIMIZE"
              ]
            }
          },
          "required": [
            "id",
            "version",
            "direction"
          ],
          "additionalProperties": false
        },
        "value": {
          "type": "number"
        },
        "source": {
          "type": "object",
          "properties": {
            "resource": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "resource",
            "digest"
          ],
          "additionalProperties": false
        },
        "evaluator": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "allOf": [
                {
                  "pattern": "\\S"
                },
                {
                  "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|^`\\\\\\u0000-\\u001f\\u007f]+$"
                },
                {
                  "pattern": "^(?:[^%]|%[A-Fa-f0-9]{2})+$"
                }
              ]
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "basis": {
          "type": "string",
          "const": "EXTERNAL_TASK_MEASUREMENT"
        }
      },
      "required": [
        "metric",
        "value",
        "source",
        "evaluator",
        "basis"
      ],
      "additionalProperties": false
    },
    "costs": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          }
        },
        "required": [
          "kind",
          "amount",
          "unit"
        ],
        "additionalProperties": false
      }
    },
    "evidenceClass": {
      "type": "string",
      "enum": [
        "SYNTHETIC",
        "OWNER_REPORTED"
      ]
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "context",
    "action",
    "independentUnit",
    "selectionProbability",
    "observedAt",
    "evaluationDigest",
    "outcome",
    "costs",
    "evidenceClass"
  ],
  "additionalProperties": false
}
