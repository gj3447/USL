@prefix usl: <urn:usl:vocab:> .
@prefix st: <urn:usl:status:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

st:RoleShape a sh:NodeShape ; sh:targetClass usl:Link ; sh:or ( st:implemented_byShape st:tested_byShape st:modeled_byShape st:defined_byShape st:proved_byShape st:compared_byShape st:bounded_byShape st:addressed_byShape st:depends_onShape st:informed_byShape st:structurally_checked_byShape ) .
st:implemented_byShape a sh:NodeShape ;
sh:property [ sh:path (usl:meaning usl:nativeId) ; sh:hasValue "urn:usl:status:implemented_by" ] ;
sh:property [ sh:path (usl:participant usl:role) ; sh:in ( "feature" "artifact" ) ] ;
sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "feature" ] ; sh:property [ sh:path usl:resource ; sh:class st:Feature ] ] ] ;
sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "artifact" ] ; sh:property [ sh:path usl:resource ; sh:class st:Artifact ] ] ] .
st:tested_byShape a sh:NodeShape ;
sh:property [ sh:path (usl:meaning usl:nativeId) ; sh:hasValue "urn:usl:status:tested_by" ] ;
sh:property [ sh:path (usl:participant usl:role) ; sh:in ( "feature" "evidence" ) ] ;
sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "feature" ] ; sh:property [ sh:path usl:resource ; sh:class st:Feature ] ] ] ;
sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "evidence" ] ; sh:property [ sh:path usl:resource ; sh:class st:TestEvidence ] ] ] .
st:modeled_byShape a sh:NodeShape ;
sh:property [ sh:path (usl:meaning usl:nativeId) ; sh:hasValue "urn:usl:status:modeled_by" ] ;
sh:property [ sh:path (usl:participant usl:role) ; sh:in ( "feature" "model" ) ] ;
sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "feature" ] ; sh:property [ sh:path usl:resource ; sh:class st:Feature ] ] ] ;
sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "model" ] ; sh:property [ sh:path usl:resource ; sh:class st:FormalModel ] ] ] .
