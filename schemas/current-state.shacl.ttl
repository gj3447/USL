sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "evidence" ] ; sh:property [ sh:path usl:resource ; sh:class st:StructuralEvidence ] ] ] .
