sh:property [ sh:path (usl:participant usl:role) ; sh:in ( "model" "artifact" ) ] ;
sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "model" ] ; sh:property [ sh:path usl:resource ; sh:class st:FormalModel ] ] ] ;
sh:property [ sh:path usl:participant ; sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ; sh:qualifiedValueShape [ sh:property [ sh:path usl:role ; sh:hasValue "artifact" ] ; sh:property [ sh:path usl:resource ; sh:class st:Artifact ] ] ] .
