{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "usl-rule-observations/v1"
    },
    "policyDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "targetDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "observations": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "allOf": [
              {
                "pattern": "\\S"
              },
              {
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|^`\\\\\\u0000-\\u001f\\u007f]+$"
              },
              {
                "pattern": "^(?:[^%]|%[A-Fa-f0-9]{2})+$"
              }
            ]
          },
          "ruleVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "evaluator": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "allOf": [
                  {
                    "pattern": "\\S"
                  },
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|^`\\\\\\u0000-\\u001f\\u007f]+$"
                  },
                  {
                    "pattern": "^(?:[^%]|%[A-Fa-f0-9]{2})+$"
                  }
                ]
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN"
            ]
          },
          "violation": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "resource": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "\\S"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              },
              "required": [
                "resource",
                "digest"
              ],
              "additionalProperties": false
            }
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          }
        },
        "required": [
          "rule",
          "ruleVersion",
          "evaluator",
          "status",
          "violation",
          "evidence",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "conflicts": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rules": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "allOf": [
                  {
                    "pattern": "\\S"
                  },
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|^`\\\\\\u0000-\\u001f\\u007f]+$"
                  },
                  {
                    "pattern": "^(?:[^%]|%[A-Fa-f0-9]{2})+$"
                  }
                ]
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "allOf": [
                  {
                    "pattern": "\\S"
                  },
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|^`\\\\\\u0000-\\u001f\\u007f]+$"
                  },
                  {
                    "pattern": "^(?:[^%]|%[A-Fa-f0-9]{2})+$"
                  }
                ]
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          }
        },
        "required": [
          "rules",
          "detail"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "policyDigest",
    "target",
    "targetDigest",
    "scope",
    "observedAt",
    "observations",
    "conflicts"
  ],
  "additionalProperties": false
}
