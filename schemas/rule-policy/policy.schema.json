{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "usl-rule-policy/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "allOf": [
        {
          "pattern": "\\S"
        },
        {
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|^`\\\\\\u0000-\\u001f\\u007f]+$"
        },
        {
          "pattern": "^(?:[^%]|%[A-Fa-f0-9]{2})+$"
        }
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "consumer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "conflictPolicy": {
      "type": "string",
      "const": "REJECT"
    },
    "scoring": {
      "type": "string",
      "const": "WEIGHTED_MEAN_VIOLATION_V1"
    },
    "rules": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "allOf": [
              {
                "pattern": "\\S"
              },
              {
                "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|^`\\\\\\u0000-\\u001f\\u007f]+$"
              },
              {
                "pattern": "^(?:[^%]|%[A-Fa-f0-9]{2})+$"
              }
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "requirement": {
            "type": "string",
            "enum": [
              "REQUIRED",
              "RECOMMENDED",
              "INFORMATIONAL"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "VIOLATION",
              "WARNING",
              "INFO"
            ]
          },
          "onViolation": {
            "type": "string",
            "enum": [
              "BLOCK",
              "WARN",
              "PENALIZE",
              "RECORD"
            ]
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evaluator": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "allOf": [
                  {
                    "pattern": "\\S"
                  },
                  {
                    "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|^`\\\\\\u0000-\\u001f\\u007f]+$"
                  },
                  {
                    "pattern": "^(?:[^%]|%[A-Fa-f0-9]{2})+$"
                  }
                ]
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "version",
          "description",
          "requirement",
          "severity",
          "onViolation",
          "weight",
          "evaluator"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "target",
    "consumer",
    "scope",
    "conflictPolicy",
    "scoring",
    "rules"
  ],
  "additionalProperties": false
}
