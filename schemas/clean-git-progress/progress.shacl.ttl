@prefix g: <urn:usl:clean-git-progress:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
g:ObservationShape a sh:NodeShape ; sh:targetClass g:Observation ;
  sh:or (
    [ sh:property [ sh:path g:package ; sh:hasValue <package:CP01> ] ; sh:property [ sh:path g:implementation ; sh:hasValue "CLEAN_EXPORT_LOCAL_SCOPE" ] ; sh:node g:CleanBoundaryShape ]
    [ sh:property [ sh:path g:package ; sh:hasValue <package:CP02> ] ; sh:property [ sh:path g:implementation ; sh:hasValue "CLEAN_RESTORE_REBIND_LOCAL_SCOPE" ] ; sh:node g:CleanBoundaryShape ]
    [ sh:property [ sh:path g:package ; sh:hasValue <package:CP03> ] ; sh:property [ sh:path g:implementation ; sh:hasValue "STATE_RESTORE_REBIND_LOCAL_SCOPE" ] ; sh:node g:StateBoundaryShape ]
  ) ;
  sh:property [ sh:path g:package ; sh:class g:Package ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path g:implementation ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path g:sourceCommit ; sh:pattern "^[a-f0-9]{40}$" ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path g:atomicSnapshot ; sh:hasValue "NOT_CLAIMED" ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path g:fullWorkspace ; sh:hasValue "CP03_CP04_PENDING" ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path g:macos ; sh:hasValue "NOT_RUN" ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path g:windows ; sh:hasValue "NOT_RUN" ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path g:authority ; sh:hasValue "NOT_GRANTED" ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path g:crashRecovery ; sh:hasValue "NOT_IMPLEMENTED" ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:class g:Receipt ; sh:minCount 1 ; sh:maxCount 1 ] .
g:CleanBoundaryShape a sh:NodeShape ;
  sh:property [ sh:path g:profile ; sh:hasValue "CLEAN_GIT_WORKTREE_V1" ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path g:restore ; sh:hasValue "RAW_REGULAR_CLEAN_TREES_ONLY" ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path g:registration ; sh:hasValue "LOCAL_PROPOSAL_ONLY" ; sh:minCount 1 ; sh:maxCount 1 ] .
g:StateBoundaryShape a sh:NodeShape ;
  sh:property [ sh:path g:emptyDirectories ; sh:hasValue "NOT_RECONSTRUCTED" ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path g:combinedDirtyExport ; sh:hasValue "NOT_IMPLEMENTED" ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path g:profile ; sh:hasValue "RAW_REGULAR_GIT_STATE_V1" ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path g:restore ; sh:hasValue "RAW_REGULAR_SELECTED_STATE_ONLY" ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path g:registration ; sh:hasValue "LOCAL_PROPOSAL_ONLY" ; sh:minCount 1 ; sh:maxCount 1 ] .
g:PackageShape a sh:NodeShape ; sh:targetClass g:Package ;
  sh:property [ sh:path g:acceptance ; sh:class g:Acceptance ; sh:minCount 2 ; sh:maxCount 2 ] ;
  sh:or (
    [ sh:in ( <package:CP01> ) ; sh:property [ sh:path g:acceptance ; sh:hasValue <acceptance:CP01-1> ] ; sh:property [ sh:path g:acceptance ; sh:hasValue <acceptance:CP01-2> ] ]
    [ sh:in ( <package:CP02> ) ; sh:property [ sh:path g:acceptance ; sh:hasValue <acceptance:CP02-1> ] ; sh:property [ sh:path g:acceptance ; sh:hasValue <acceptance:CP02-2> ] ]
    [ sh:in ( <package:CP03> ) ; sh:property [ sh:path g:acceptance ; sh:hasValue <acceptance:CP03-1> ] ; sh:property [ sh:path g:acceptance ; sh:hasValue <acceptance:CP03-2> ] ]
  ) .
g:AcceptanceShape a sh:NodeShape ; sh:targetClass g:Acceptance ;
  sh:or (
    [ sh:in ( <acceptance:CP01-1> <acceptance:CP01-2> <acceptance:CP02-1> <acceptance:CP02-2> ) ; sh:property [ sh:path g:coverage ; sh:hasValue "LOCAL_CASES_PASS" ] ]
    [ sh:in ( <acceptance:CP03-1> <acceptance:CP03-2> ) ; sh:property [ sh:path g:coverage ; sh:hasValue "LOCAL_STATE_PROFILE_CASES_PASS" ] ]
  ) ;
  sh:property [ sh:path g:coverage ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path g:checkedBy ; sh:class g:TestResult ; sh:minCount 1 ] .
g:CP03AcceptanceOneShape a sh:NodeShape ; sh:targetNode <acceptance:CP03-1> ;
  sh:property [ sh:path g:coverage ; sh:hasValue "LOCAL_STATE_PROFILE_CASES_PASS" ; sh:minCount 1 ; sh:maxCount 1 ] .
g:CP03AcceptanceTwoShape a sh:NodeShape ; sh:targetNode <acceptance:CP03-2> ;
  sh:property [ sh:path g:coverage ; sh:hasValue "LOCAL_STATE_PROFILE_CASES_PASS" ; sh:minCount 1 ; sh:maxCount 1 ] .
g:TestShape a sh:NodeShape ; sh:targetClass g:TestResult ;
  sh:property [ sh:path g:name ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path g:status ; sh:hasValue "PASS" ; sh:minCount 1 ; sh:maxCount 1 ] .
g:ReceiptShape a sh:NodeShape ; sh:targetClass g:Receipt ;
  sh:property [ sh:path g:sha256 ; sh:pattern "^sha256:[a-f0-9]{64}$" ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path g:tapDigest ; sh:pattern "^sha256:[a-f0-9]{64}$" ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path g:authority ; sh:hasValue "SECONDARY_AI" ; sh:minCount 1 ; sh:maxCount 1 ] .
