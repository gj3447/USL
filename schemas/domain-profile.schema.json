{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "usl-domain-profile/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "allOf": [
        {
          "pattern": "\\S"
        },
        {
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|^`\\\\\\u0000-\\u001f\\u007f]+$"
        },
        {
          "pattern": "^(?:[^%]|%[A-Fa-f0-9]{2})+$"
        }
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "closedMeanings": {
      "type": "boolean"
    },
    "meanings": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "allowExtraRoles": {
            "type": "boolean"
          },
          "roles": {
            "minItems": 1,
            "maxItems": 128,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "required": {
                  "type": "boolean"
                },
                "types": {
                  "minItems": 1,
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "allOf": [
                      {
                        "pattern": "\\S"
                      },
                      {
                        "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|^`\\\\\\u0000-\\u001f\\u007f]+$"
                      },
                      {
                        "pattern": "^(?:[^%]|%[A-Fa-f0-9]{2})+$"
                      }
                    ]
                  }
                },
                "metadata": {
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096,
                        "pattern": "\\S"
                      },
                      "equals": {
                        "$ref": "#/$defs/__schema0"
                      }
                    },
                    "required": [
                      "key",
                      "equals"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "role",
                "required",
                "types",
                "metadata"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "allowExtraRoles",
          "roles"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "closedMeanings",
    "meanings"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
