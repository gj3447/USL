{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "usl-cli-host/v1"
    },
    "bindings": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "workspaces": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "\\S"
      }
    },
    "maxSourceBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "actions": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "descriptor": {
            "type": "object",
            "properties": {
              "schema": {
                "type": "string",
                "const": "usl-capability/v1"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "connection": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "nativeOperation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "sourceDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "READ",
                  "ACTION",
                  "SUBSCRIBE"
                ]
              },
              "effect": {
                "type": "string",
                "enum": [
                  "READ",
                  "WRITE",
                  "UNKNOWN"
                ]
              },
              "meanings": {
                "maxItems": 128,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "allOf": [
                    {
                      "pattern": "\\S"
                    },
                    {
                      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|^`\\\\\\u0000-\\u001f\\u007f]+$"
                    },
                    {
                      "pattern": "^(?:[^%]|%[A-Fa-f0-9]{2})+$"
                    }
                  ]
                }
              },
              "requiredScopes": {
                "maxItems": 128,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "\\S"
                }
              },
              "input": {
                "type": "object",
                "properties": {
                  "types": {
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "allOf": [
                        {
                          "pattern": "\\S"
                        },
                        {
                          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|^`\\\\\\u0000-\\u001f\\u007f]+$"
                        },
                        {
                          "pattern": "^(?:[^%]|%[A-Fa-f0-9]{2})+$"
                        }
                      ]
                    }
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "allOf": [
                      {
                        "pattern": "\\S"
                      },
                      {
                        "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|^`\\\\\\u0000-\\u001f\\u007f]+$"
                      },
                      {
                        "pattern": "^(?:[^%]|%[A-Fa-f0-9]{2})+$"
                      }
                    ]
                  },
                  "schema": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "$ref": "#/$defs/__schema0"
                        }
                      }
                    ]
                  }
                },
                "required": [
                  "types",
                  "schema"
                ],
                "additionalProperties": false
              },
              "output": {
                "type": "object",
                "properties": {
                  "types": {
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "allOf": [
                        {
                          "pattern": "\\S"
                        },
                        {
                          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|^`\\\\\\u0000-\\u001f\\u007f]+$"
                        },
                        {
                          "pattern": "^(?:[^%]|%[A-Fa-f0-9]{2})+$"
                        }
                      ]
                    }
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "allOf": [
                      {
                        "pattern": "\\S"
                      },
                      {
                        "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s<>\"{}|^`\\\\\\u0000-\\u001f\\u007f]+$"
                      },
                      {
                        "pattern": "^(?:[^%]|%[A-Fa-f0-9]{2})+$"
                      }
                    ]
                  },
                  "schema": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "$ref": "#/$defs/__schema0"
                        }
                      }
                    ]
                  }
                },
                "required": [
                  "types",
                  "schema"
                ],
                "additionalProperties": false
              },
              "mapping": {
                "type": "object",
                "properties": {
                  "completeness": {
                    "type": "string",
                    "enum": [
                      "COMPLETE",
                      "PARTIAL",
                      "UNKNOWN"
                    ]
                  },
                  "losses": {
                    "maxItems": 256,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096,
                          "pattern": "\\S"
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096,
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "path",
                        "reason"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "unsupported": {
                    "maxItems": 256,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "\\S"
                    }
                  }
                },
                "required": [
                  "completeness",
                  "losses",
                  "unsupported"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "schema",
              "id",
              "version",
              "connection",
              "nativeOperation",
              "sourceDigest",
              "kind",
              "effect",
              "meanings",
              "requiredScopes",
              "input",
              "output",
              "mapping"
            ],
            "additionalProperties": false
          },
          "policy": {
            "type": "object",
            "properties": {
              "connection": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "capabilityId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "descriptorDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "sourceDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "allowedEffects": {
                "maxItems": 2,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "READ",
                    "WRITE"
                  ]
                }
              },
              "allowedScopes": {
                "maxItems": 128,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "\\S"
                }
              },
              "allowLossy": {
                "type": "boolean"
              },
              "maxInputBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1048576
              },
              "maxOutputBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1048576
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 300000
              }
            },
            "required": [
              "connection",
              "capabilityId",
              "descriptorDigest",
              "sourceDigest",
              "allowedEffects",
              "allowedScopes",
              "allowLossy",
              "maxInputBytes",
              "maxOutputBytes",
              "timeoutMs"
            ],
            "additionalProperties": false
          },
          "graph": {
            "type": "object",
            "properties": {
              "source": {
                "type": "object",
                "properties": {
                  "resource": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "\\S"
                  },
                  "representation": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "resource"
                ],
                "additionalProperties": false
              },
              "sourceDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "graphId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "graphspecDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "node": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "scope": {
                "type": "string",
                "const": "ENTRY_NODE_ONLY"
              }
            },
            "required": [
              "source",
              "sourceDigest",
              "graphId",
              "graphspecDigest",
              "node",
              "scope"
            ],
            "additionalProperties": false
          },
          "cwd": {
            "type": "object",
            "properties": {
              "resource": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "representation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              }
            },
            "required": [
              "resource"
            ],
            "additionalProperties": false
          },
          "command": {
            "type": "object",
            "properties": {
              "executable": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "node"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "path"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "args": {
                "maxItems": 128,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 4096
                    },
                    {
                      "type": "object",
                      "properties": {
                        "resource": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096,
                          "pattern": "\\S"
                        },
                        "representation": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096,
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "resource"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "envAllowlist": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              }
            },
            "required": [
              "executable",
              "args",
              "envAllowlist"
            ],
            "additionalProperties": false
          },
          "pins": {
            "minItems": 1,
            "maxItems": 128,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "object",
                  "properties": {
                    "resource": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "\\S"
                    },
                    "representation": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "resource"
                  ],
                  "additionalProperties": false
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              },
              "required": [
                "source",
                "digest"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "descriptor",
          "policy",
          "graph",
          "cwd",
          "command",
          "pins"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "bindings",
    "workspaces",
    "maxSourceBytes",
    "actions"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
