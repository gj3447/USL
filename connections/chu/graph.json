  "meanings": [
    {
      "id": "chu:conceptual-containment",
      "description": "User-primary scope (2026-09-27): CHU is the broader computable-hyperuniverse concept that contains HSWM (LLM-only AI) and non-LLM world models. Conceptual inclusion, not a storage or implementation claim."
    },
    {
      "id": "chu:ai-native-principles",
      "description": "The user's three AI-native principles, CHU's hypergraph rationale, and HSWM's bounded Lean translation of them. Lean proofs are not replayed by this link."
    },
    {
      "id": "chu:n-ary-link-grammar",
      "description": "SECONDARY_AI mapping: a USL link (meaning + role-named participants) is the notation CHU OS uses for role-bearing n-ary hyperedges across repositories. USL remains a grammar/binding layer, not a database; state ownership stays with each system."
    },
    {
      "id": "chu:workspace-linking-contract",
      "description": "The common USL workspace-linking agent block applied to CHU, HSWM and USL. A binding grants no access."
    },
    {
      "id": "chu:os-kernel-materials",
      "description": "CHU OS plan graph, Wolfram rewrite Lean model and the multiway kernel prototype. Nothing is executed by this link."
    }
  ],
